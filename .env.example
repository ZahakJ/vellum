# Vellum configuration — copy to .env; npm scripts load it automatically
# (node --env-file-if-exists=.env), no export/source needed.

# Port the server listens on (default 6801).
#PORT=6801

# Path to your vault directory (default ./vault, seeded from vault-seed/).
#VELLUM_VAULT=/path/to/your/vault

# Admin password as an argon2id hash — generate with: npm run hash-password
# Single-quote it: the hash contains $ characters.
# Unset → open local mode: every visitor is admin (a warning is printed).
#ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'

# Secret that signs session cookies. Any long random string, e.g.:
#   openssl rand -hex 32
# Unset while a password hash is set → an ephemeral secret is generated and
# sessions stop working after each restart.
#SESSION_SECRET=

# PUBLIC=false requires login even for reading; default: anyone can read,
# only the admin session can edit.
#PUBLIC=true

# Comma-separated IPs/CIDRs whose X-Forwarded-For header is trusted for the
# login rate limit — set this to your reverse proxy's address when running
# behind one. Unset → the header is ignored (clients can forge it) and the
# rate limit keys off the direct socket address.
#TRUSTED_PROXIES=127.0.0.1,::1

# Request-body sizes are capped server-side (10 MB on any /api request, 64 KB
# on the anonymous surfaces: comment posts and login) so oversized uploads are
# rejected before they occupy memory. No env key needed — but when running behind a reverse proxy,
# set its own cap too as an extra layer, e.g. nginx: client_max_body_size 10m;

# Vault-relative note opened for fresh visitors (like a homepage).
#HOME_NOTE=Welcome.md

# COMMENTS=on lets readers leave comments ("Marginalia") under published
# notes. Off by default: the routes 404 and no comment UI renders anywhere.
#COMMENTS=on

# Where server-side data lives (the comments SQLite db, your custom.css).
# Created on demand. Default: ./data (already gitignored).
#VELLUM_DATA=./data

# Site name shown everywhere the UI says "Vellum": the sidebar wordmark,
# browser tab titles, and the sign-in modal. Default: Vellum.
#SITE_NAME=Night Garden

# Theme applied for visitors who have not picked one themselves (their own
# choice, once made, always wins and is stored in their browser).
# One of: iron-gall (default), void, lapis, parchment.
#DEFAULT_THEME=parchment

# Comma-separated tags hidden from the visitor-facing site: they never appear
# as sidebar topic sections or tag pills. Useful for workflow/status tags
# (zettel maturity, todo states) that are meaningful in the vault but read as
# noise on the published site. Case-insensitive; a leading # is fine. Admin
# views are unaffected, and the notes themselves stay published.
#EXCLUDE_TAGS=baby,child,adult

# Custom styling needs no env key: drop a custom.css into VELLUM_DATA and it
# is served at /api/custom.css and loaded after the built-in styles for every
# visitor — see the "Theming" section of the README for the CSS token API.
