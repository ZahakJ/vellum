# Vellum configuration — copy to .env; npm scripts load it automatically
# (node --env-file-if-exists=.env), no export/source needed.
#
# Runtime settings: most site-identity keys below (SITE_NAME, SITE_TAGLINE,
# SITE_FOOTER, DEFAULT_THEME, PUBLIC_LAYOUT, BLOG_LOCALE, SITE_LANG,
# LANGUAGE_FILTER, EXCLUDE_TAGS, COMMENTS, HOME_NOTE) can also be changed live
# from the admin UI ("Site settings" — the status-bar gear), stored in
# VELLUM_DATA/settings.json.
# A saved settings.json value OVERRIDES its env default; clearing it in the
# panel falls back to env. Security keys (ADMIN_PASSWORD_HASH, SESSION_SECRET,
# TRUSTED_PROXIES, PORT, HOST, VELLUM_VAULT, VELLUM_DATA, PUBLIC) are
# env-only forever.

# Port the server listens on (default 6801).
#PORT=6801

# Path to your vault directory (default ./vault, seeded from vault-seed/).
#VELLUM_VAULT=/path/to/your/vault

# Admin password as an argon2id hash — generate with: npm run hash-password
# Single-quote it: the hash contains $ characters.
# Unset → open local mode: every visitor is admin (a warning is printed).
#ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'

# Secret that signs session cookies. Any long random string, e.g.:
#   openssl rand -hex 32
# Unset while a password hash is set → an ephemeral secret is generated and
# sessions stop working after each restart.
#SESSION_SECRET=

# PUBLIC=false requires login even for reading; default: anyone can read,
# only the admin session can edit.
# It needs ADMIN_PASSWORD_HASH: without a password there is no session to
# require, so the server REFUSES TO START rather than run as an anonymous,
# fully writable admin instance while claiming to be private.
#PUBLIC=true

# Force the session cookie's Secure flag. Unset (recommended) derives it per
# request: https directly, or X-Forwarded-Proto from an address listed in
# TRUSTED_PROXIES. Set false only for a deliberately plain-http LAN instance.
#SECURE_COOKIES=true

# Bind address (default 0.0.0.0 — reachable from your network). Binding a
# non-loopback address without ADMIN_PASSWORD_HASH means every machine that
# can reach the port is an admin of this vault; the server says so at startup.
#HOST=127.0.0.1

# Comma-separated IPs/CIDRs whose X-Forwarded-For header is trusted for the
# login rate limit — set this to your reverse proxy's address when running
# behind one. Unset → the header is ignored (clients can forge it) and the
# rate limit keys off the direct socket address.
#TRUSTED_PROXIES=127.0.0.1,::1

# Request-body sizes are capped server-side (10 MB on any /api request, 64 KB
# on the anonymous surfaces: comment posts and login) so oversized uploads are
# rejected before they occupy memory. No env key needed — but when running behind a reverse proxy,
# set its own cap too as an extra layer, e.g. nginx: client_max_body_size 10m;

# Vault-relative note opened for fresh visitors (like a homepage).
#HOME_NOTE=Welcome.md

# COMMENTS=on lets readers leave comments ("Marginalia") under published
# notes. Off by default: the routes 404 and no comment UI renders anywhere.
#COMMENTS=on

# Where server-side data lives: settings.json, the comments SQLite db, your
# custom.css, the webfont cache and any fonts you upload (fonts/custom/).
# Created on demand. Default: ./data (already gitignored).
#VELLUM_DATA=./data

# Site name shown everywhere the UI says "Vellum": the sidebar wordmark,
# browser tab titles, and the sign-in modal. Default: Vellum.
#SITE_NAME=Night Garden

# Theme applied for visitors who have not picked one themselves (their own
# choice, once made, always wins and is stored in their browser).
# Fifteen built-in themes — an unknown name here is ignored, with one line on
# stderr at startup naming the valid set:
#   dark   iron-gall (default), cinnabar, sumi, void, basalt, nocturne, lapis,
#          verdigris, moss, porphyry, tallow
#   light  parchment, sandstone, solar, linen
# Case is not significant: the value is trimmed and lowercased before it is
# validated, on this side and through PATCH /api/settings alike.
#DEFAULT_THEME=cinnabar

# Comma-separated tags hidden from the visitor-facing site: they never appear
# as sidebar topic sections or tag pills. Useful for workflow/status tags
# (zettel maturity, todo states) that are meaningful in the vault but read as
# noise on the published site. Case-insensitive; a leading # is fine. Admin
# views are unaffected, and the notes themselves stay published.
#EXCLUDE_TAGS=baby,child,adult

# Vault-relative directory where images uploaded through the app (the
# "Set banner…" modal's drag/drop + file picker) are stored. Created on
# demand. Default: attachments
#ATTACHMENTS_DIR=attachments

# Note banners: give any note a hero image with frontmatter
#   banner: attachments/cover.png     (vault-relative attachment path)
#   banner: https://…/cover.jpg      (or a URL)
# It renders above the note in the editor/reading view and as the article
# hero + list thumbnail in blog mode. Published notes' banner attachments are
# automatically visitor-fetchable. Posts WITHOUT a banner get a deterministic
# abstract gradient (from the note title) in the blog list + article hero:
#   BANNER_FALLBACK=generated  (default) | none  (no stand-in hero at all)
#BANNER_FALLBACK=generated

# Custom styling needs no env key: drop a custom.css into VELLUM_DATA and it
# is served at /api/custom.css and loaded after the built-in styles for every
# visitor — see the "Theming" section of the README for the CSS token API.
# Custom fonts too: files in VELLUM_DATA/fonts/ are served at /api/fonts/<file>
# (woff2/woff/ttf/otf, long-cached) for @font-face rules in your custom.css.
#
# Typography needs no env key either, and neither do your own faces: upload
# them in Site settings -> Typography (woff2/woff/ttf/otf, 5 MB each). They
# land in VELLUM_DATA/fonts/custom/, are served from this instance only, and
# are offered in all four font slots — see "Typography" in the README. The
# whole of VELLUM_DATA is gitignored, so an uploaded face never reaches your
# notes repository.

# ------------------------------------------------------------- Backup & sync

# Backup & sync (Site settings → Backup & sync) is configured in the panel, not
# here — remote, branch, schedule and credentials all live in settings.json /
# VELLUM_DATA. This is the one exception.
#
# Vellum deletes GIT_SSH_COMMAND (and GIT_CONFIG*, GIT_SSH, GIT_PROXY_COMMAND,
# GIT_DIR, …) from the environment of every git process it spawns, so nothing
# in the server's own environment can redirect git's transport, config or work
# tree by accident. If you genuinely need a custom SSH invocation — a specific
# deploy key for the vault, most often — name it here and Vellum passes exactly
# this string to git as GIT_SSH_COMMAND. Nothing else can.
#VELLUM_GIT_SSH_COMMAND=ssh -i /home/vellum/.ssh/vault_ed25519 -o IdentitiesOnly=yes

# ------------------------------------------------------- Language & direction

# SITE_LANG sets the language of the CHROME — every label, button, placeholder
# and toast in both the app and the blog shell — and, for "ar", mirrors the
# entire interface right-to-left (<html dir="rtl" lang="ar">: sidebar on the
# right, panels on the left, arrows and chevrons flipped, menus and modals
# mirrored). Your NOTES are never translated or re-flowed: each block already
# picks its own direction from its own text, so a vault mixing Arabic and
# English reads correctly under either setting. Values: en (default) | ar.
#SITE_LANG=ar

# With BLOG_LOCALE unset, SITE_LANG=ar also formats post dates in Arabic
# (Eastern Arabic numerals: ١٤ يوليو ٢٠٢٦). Set BLOG_LOCALE explicitly to
# override — e.g. BLOG_LOCALE=ar-u-nu-latn for Arabic months with 1/2/3 digits.

# LANGUAGE_FILTER=true limits the PUBLIC blog surfaces — post lists, topics,
# graph, search, prev/next, most-discussed, RSS — to notes actually written in
# SITE_LANG's script (Arabic-block characters ≥ 40% of a note's letters when
# SITE_LANG=ar; the majority-non-Arabic notes when SITE_LANG=en). Detection is
# server-side and cached per note. Admin views are never filtered.
#
# This is CURATION, NOT ACCESS CONTROL. A published note that the filter hides
# from the lists is still served on its own URL to anyone who has the link (and
# still appears in /api/tree, which is what makes those links resolve). Use
# `publish: false` — not this switch — to keep something off the public site.
#LANGUAGE_FILTER=true

# Visitor language switch: settings-only (no env counterpart), OFF by default.
# Site settings → Visitor switch adds a small EN/ع control to the public nav;
# a reader's choice is kept in their own browser and overrides SITE_LANG for
# the CHROME STRINGS and DIRECTION only — never note content, and never the
# dates/numerals, which stay on BLOG_LOCALE (one numbering system per site).

# ---------------------------------------------------------------- Blog mode

# PUBLIC_LAYOUT=blog turns the visitor-facing site into a classic blog:
# masthead (SITE_NAME + tagline), topic nav, article pages with date/reading
# time/tags, comments below, footer. Admin sessions always keep the full app.
#
# PUBLIC_LAYOUT=designed composes the visitor site from the design you author
# in VELLUM_DATA/designs.json instead. The built-in blog stays exactly where it
# is: switching between the two is lossless in both directions, and a design
# that cannot render drops visitors back to the blog automatically while
# telling YOU which section failed.
#
# Anything else: the app-style public layout (the default).
#PUBLIC_LAYOUT=blog

# Masthead subtitle shown under the site name in blog mode.
#SITE_TAGLINE=Notes from the canopy

# Footer line in blog mode. {year} and {siteName} are substituted.
# Default: "© {year} {SITE_NAME}".
#SITE_FOOTER=© {year} {siteName} — all rights reserved

# BCP47 locale used to format post dates in blog mode (client-side via
# Intl.DateTimeFormat) and declared as the RSS channel language. Default: en.
# e.g. ar, ar-EG, de, fr, tr…
#BLOG_LOCALE=en

# Canonical origin for absolute links in the RSS feed and SEO canonical tags.
# Unset → derived per request from Host / X-Forwarded-* headers, which is
# usually right behind a well-configured reverse proxy.
#SITE_URL=https://notes.example.com

# The blog surfaces need no further switches:
#   GET /api/posts — published notes as posts (title, ISO date from
#     frontmatter date:/created: else file times, ~220-char excerpt, word
#     count, reading minutes, EXCLUDE_TAGS-filtered tags), newest first.
#   GET /feed.xml — RSS 2.0 feed of the same posts (advertised via
#     <link rel="alternate"> on every page). Available in app layout too.
#   SEO — every served page gets server-side <title>/description/og/canonical
#     meta: a published note's own meta on its deep link, generic site meta
#     everywhere else (unpublished paths are indistinguishable from unknown
#     ones). With PUBLIC=false all of this stays behind login.
