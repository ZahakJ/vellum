{
  "name": "vellum",
  "version": "2.3.0",
  "description": "A self-hosted, clone-and-run Obsidian-style markdown vault: live-preview editor, wikilinks, backlinks, graph view, full-text search.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && node --env-file-if-exists=.env server/index.ts",
    "serve": "node --env-file-if-exists=.env server/index.ts",
    "hash-password": "node scripts/hash-password.ts",
    "typecheck": "tsc --noEmit",
    "check-i18n": "node scripts/check-i18n.mjs",
    "check-presets": "node scripts/check-presets.mjs",
    "check-signatures": "node scripts/check-signatures.mjs",
    "check-contrast": "node scripts/check-contrast.mjs",
    "check-caret": "node scripts/check-caret.mjs",
    "check-sections": "node scripts/check-sections.mjs",
    "check-excerpt": "node scripts/check-excerpt.mjs",
    "check-design": "node scripts/shoot-design.mjs",
    "check-board": "node scripts/check-board.mjs",
    "check-preview": "node scripts/check-preview.mjs",
    "check-print": "node scripts/check-print.mjs",
    "check-a11y": "node scripts/check-a11y.mjs",
    "check-bundle": "node scripts/check-bundle.mjs",
    "check-books": "node scripts/check-books.mjs",
    "check-hovercache": "node scripts/check-hovercache.mjs",
    "check-designer-nav": "node scripts/check-designer-nav.mjs",
    "check-layouts": "node scripts/check-layouts.mjs",
    "check-keymap": "node scripts/check-keymap.mjs",
    "check-desktop": "node scripts/check-desktop.mjs",
    "check-settings": "node scripts/check-settings.mjs",
    "desktop": "npm --prefix desktop run start",
    "desktop:typecheck": "npm --prefix desktop run typecheck",
    "desktop:probe": "npm --prefix desktop run probe",
    "desktop:dist": "npm --prefix desktop run dist",
    "test": "node --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@hono/node-server": "^2.0.8",
    "@lezer/highlight": "^1.2.0",
    "@lezer/markdown": "^1.6.4",
    "@replit/codemirror-vim": "^6.3.0",
    "argon2": "^0.45.1",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.27",
    "katex": "^0.18.4",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
