{
  "name": "vellum",
  "version": "0.1.0",
  "description": "A self-hosted, clone-and-run Obsidian-style markdown vault: live-preview editor, wikilinks, backlinks, graph view, full-text search.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && node server/index.ts",
    "serve": "node server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@hono/node-server": "^2.0.8",
    "@lezer/markdown": "^1.6.4",
    "@replit/codemirror-vim": "^6.3.0",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.27",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
