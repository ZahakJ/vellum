# `engines` in package.json is advisory to npm by default — it prints a warning
# and installs anyway. Vellum's floor is not advisory: below Node 24 the server
# does not start at all (unflagged TypeScript execution, `node:sqlite`, and
# `--env-file-if-exists` in every npm script), so the clone must fail at
# `npm install` with the version in the message rather than at `npm start`
# with a syntax error from inside a .ts file.
engine-strict=true
