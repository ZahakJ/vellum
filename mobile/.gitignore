# mobile/ is its own npm package, so it carries its own ignores — the repo root
# covers `node_modules/` and `dist/`, neither of which is what this package
# builds.

node_modules/

# The Vite build of the shell. `cap sync` copies it into the APK; nothing reads
# it from here.
www/

# Gradle's working state and every build output under it.
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/local.properties
android/.idea/
android/*.iml

# Config `cap sync` regenerates from capacitor.config.ts on every run. Checking
# it in means two sources of truth and one of them silently stale.
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml

# THE SIGNING KEY AND ITS PASSWORDS. Losing this file means never being able to
# update an installed copy of the app again; publishing it means anyone can
# forge one. It is generated by hand on the release machine — see README.md —
# and belongs in a password manager, not in git.
vellum-release.keystore
*.keystore
*.jks
keystore.properties

# Finished APKs. They are large, binary, and reproducible from a tag.
out/
*.apk
*.aab
