<?xml version="1.0" encoding="utf-8"?>
<!-- The splash: iron-gall ground, gold ✦ at the optical centre.

     A layer-list over a vector, not the eleven density-and-orientation PNGs
     Capacitor's template ships. Those existed to cover every screen a stretched
     bitmap would smear; a shape with no pixels in it does not have that problem,
     and one file that is right at every size beats ten that are approximately
     right at one each. It also means the mark on the splash is the SAME path as
     the mark on the launcher icon — both generated by icons/make-icons.mjs —
     rather than a bitmap of it that has to be regenerated in step. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/iron_gall" />
    <item
        android:drawable="@drawable/splash_star"
        android:gravity="center"
        android:width="88dp"
        android:height="88dp" />
</layer-list>
