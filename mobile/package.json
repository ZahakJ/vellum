{
  "name": "vellum-mobile",
  "version": "2.0.1",
  "private": true,
  "description": "The Vellum Android app: a Capacitor shell whose only job is to find your server and then get out of the way.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "sync": "npm run build && cap sync android",
    "typecheck": "tsc --noEmit",
    "icons": "node icons/make-icons.mjs",
    "apk:debug": "node scripts/build-apk.mjs debug",
    "apk:release": "node scripts/build-apk.mjs release"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
