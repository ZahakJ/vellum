node_modules/
dist/
vault/
data/
.env
shots/
*.log
.DS_Store

# the desktop app's build artifacts. `desktop/build/preload.js` is compiled
# rather than type-stripped because a sandboxed preload is loaded by Chromium,
# not by Node (see electron/preload.ts); `desktop/release/` is electron-builder's
# output, which `dist/` above does NOT cover — that one is the web client.
desktop/build/
desktop/release/

# agent worktrees and session scratch
.claude/

# The scratch yard: gate fixtures, scratch vaults, perf harnesses, verification
# screenshots. Every gate that needs a vault of its own builds one in here
# (`scratchpad/gates/`), and the v1.8 rounds left scale harnesses and shot runs
# beside them. None of it is the product, all of it is regenerable, and some of
# it is a whole seeded vault — which is how a scratch directory ends up in a
# release commit the one time somebody runs `git add -A`.
scratchpad/

# Per-machine Claude Code permission rules; the project settings stay shared.
.claude/settings.local.json
